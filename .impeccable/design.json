  "narrative": {
    "northStar": "The Review Desk",
    "overview": "The review desk pairs warm paper surfaces with neutral outlined actions, neutral selections and slate text. Compact system typography carries controls and workflow states; serif passages distinguish source material from analyst actions. The visual hierarchy keeps evidence legible and decisions deliberate.\n\nThe system is primarily flat. Subtle tonal changes, thin dividers and modest corners group related work without turning each item into a floating card.",
    "keyCharacteristics": [
      "Warm paper surfaces and slate ink.",
      "Compact controls with visible keyboard focus.",
      "Serif evidence within a system sans interface.",
      "Tonal grouping and restrained status color."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "Pair every status color with an explicit text label.",
        "section": "colors"
      },
      {
        "name": "The Evidence Voice Rule",
        "body": "Serif type distinguishes source passages from workflow instructions and analyst controls.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do reserve Georgia for quoted evidence and source text.",
      "Do use thin dividers and tonal surfaces to group work.",
      "Do keep keyboard focus clearly visible.",
      "Do preserve readable source passages on small screens."
    ],
    "donts": [
      "Don't apply serif styling to controls or navigation.",
      "Don't use status color without a written label.",
      "Don't create separate nested scrolling panes in the mobile evidence review."
    ]
  }
